{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-superagent",
  "version": "0.5.1",
  "description": "Superagent: a resident router agent that dispatches background worker agents in OpenCode",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xtccc/opencode-superagent.git"
  },
  "homepage": "https://github.com/xtccc/opencode-superagent#readme",
  "bugs": {
    "url": "https://github.com/xtccc/opencode-superagent/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "agent",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent",
    "orchestration"
  ],
  "scripts": {
    "build": "bun run script/build.ts",
    "prepare": "bun run build",
    "prepack": "bun run build",
    "test": "bun test",
    "test:e2e": "bun run e2e/plugin-load.e2e.ts",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit",
    "release:check": "bun run script/release-check.ts",
    "prepublishOnly": "bun run release:check"
  },
  "dependencies": {
    "@opencode/schema": "^2.2.5"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.27 || ^0.0.0-dev",
    "@opentui/solid": ">=0.8.1",
    "effect": "^4.1.0 || ^0.0.0-dev",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/client": "^2.2.5",
    "@opencode/plugin": "^2.2.5",
    "@opentui/solid": "0.8.1",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.3",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "effect": "4.1.0",
    "solid-js": "1.9.17"
  }
}
